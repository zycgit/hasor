<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>net.hasor</groupId>
        <artifactId>hasor-boot</artifactId>
        <version>5.0.0-SNAPSHOT</version>
    </parent>

    <!-- Maven Info -->
    <artifactId>hasor-boot-loader</artifactId>
    <packaging>jar</packaging>

    <!-- Project Info -->
    <name>Hasor-Boot-Loader</name>
    <description>runtime launcher for Hasor executable archives.</description>

    <dependencies>
        <dependency>
            <groupId>net.hasor</groupId>
            <artifactId>cobble-loader</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Hasor Boot loader must be self-contained before the application ClassLoader exists. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createSourcesJar>true</createSourcesJar>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>net.hasor:hasor-boot-loader</include>
                                    <include>net.hasor:cobble-loader</include>
                                    <include>net.hasor:cobble-lang</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
